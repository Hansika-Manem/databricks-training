-- Method 1: Conditional Logic
SELECT customer_id, first_name, last_name, total_spend,
    CASE 
        WHEN total_spend > 2000 THEN 'Gold'
        WHEN total_spend BETWEEN 500 AND 2000 THEN 'Silver'
        ELSE 'Bronze'
    END AS segment
FROM customer_spend
ORDER BY total_spend DESC


-- Method 2: Bucketizer (MLlib)
--SQL (equivalent logic)
SELECT customer_id, total_spend,
    CASE
        WHEN total_spend <= 500 THEN 0
        WHEN total_spend <= 2000 THEN 1
        ELSE 2
    END AS bucket_index
FROM customer_spend


--Method 5: Window-based ranking (percent_rank)
SELECT customer_id, total_spend,
    PERCENT_RANK() OVER (ORDER BY total_spend) AS spend_percentile,
    CASE
        WHEN PERCENT_RANK() OVER (ORDER BY total_spend) >= 0.66 THEN 'Gold'
        WHEN PERCENT_RANK() OVER (ORDER BY total_spend) >= 0.33 THEN 'Silver'
        ELSE 'Bronze'
    END AS segment_rank_based
FROM customer_spend
ORDER BY total_spend DESC
