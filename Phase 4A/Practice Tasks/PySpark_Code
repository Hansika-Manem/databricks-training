--Task 3: Quantile-based segmentation
quantiles = customer_spend.approxQuantile("total_spend", [0.33, 0.66], 0.0)
low, high = quantiles
print("cutoffs:", low, high)   # ~445.0, ~1635.0 on your data

quantile_segmented = customer_spend.withColumn(
    "segment_quantile",
    when(col("total_spend") > high, "Gold")
    .when((col("total_spend") > low) & (col("total_spend") <= high), "Silver")
    .otherwise("Bronze")
)
quantile_segmented.groupBy("segment_quantile").agg(count("*").alias("customer_count")).show()


