--Business Pipeline Exercises

--1. Read sales data -> clean nulls -> calculate daily sales
from pyspark.sql.functions import sum as _sum

daily_sales = (orders
    .filter(col("amount").isNotNull())
    .groupBy("order_date")
    .agg(_sum("amount").alias("daily_sales"))
    .orderBy("order_date"))
daily_sales.show()


--2. Read customer data -> clean invalid rows -> city-wise revenue
city_revenue = (customers.filter(col("city").isNotNull())
    .join(orders, "customer_id")
    .groupBy("city")
    .agg(_sum("amount").alias("total_revenue"))
    .orderBy(col("total_revenue").desc()))
city_revenue.show()


--3. Find repeat customers (>2 orders)
from pyspark.sql.functions import count

repeat_customers = (customers.join(orders, "customer_id")
    .groupBy("customer_id", "name")
    .agg(count("order_id").alias("order_count"))
    .filter(col("order_count") > 2))
repeat_customers.show()


--4. Find highest spending customer in each city
from pyspark.sql.window import Window
from pyspark.sql.functions import rank

customer_spend = (customers.join(orders, "customer_id")
    .groupBy("city", "customer_id", "name")
    .agg(_sum("amount").alias("total_spend")))

city_window = Window.partitionBy("city").orderBy(col("total_spend").desc())

top_per_city = (customer_spend
    .withColumn("rnk", rank().over(city_window))
    .filter(col("rnk") == 1)
    .drop("rnk"))
top_per_city.show()


--5. Build final reporting table with customer, city, total spend, order count
reporting_table = (customers.join(orders, "customer_id")
    .groupBy("customer_id", "name", "city")
    .agg(
        _sum("amount").alias("total_spend"),
        count("order_id").alias("order_count")
    )
    .orderBy(col("total_spend").desc()))
reporting_table.show()
